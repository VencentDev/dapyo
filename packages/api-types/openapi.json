  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "KycStatus": {
        "type": "string",
        "enum": ["NONE", "PENDING", "VERIFIED", "REJECTED"]
      },
      "PageResponseTodoResponse": {
        "type": "object",
        "required": ["content", "page", "size", "totalElements", "totalPages"],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoResponse"
            }
          },
